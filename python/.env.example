# =================================================================
# 大连市皮肤病医院绩效测算 - 数据同步环境配置模板
# =================================================================
# 使用方式:
#   1. 复制本文件为 `.env` (同目录)
#   2. 按实际环境修改连接参数
#   3. `.env` 严禁提交至 Git (内含明文口令)
#
# 修改日志：
# 2026-09-11 15:20:00 | 配置新建 | 建立 Oracle -> SQL Server 同步连接参数隔离模板
# =================================================================

# -----------------------------------------------------------------
# 源端: Oracle (运行于 192.168.130.32)
# -----------------------------------------------------------------
ORACLE_HOST=192.168.130.32
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=xepdb1
ORACLE_USER=system
ORACLE_PASSWORD=123456
# 源表所属 Schema (必须显式限定, 防止 SYSTEM 下同名表污染)
ORACLE_SCHEMA=DL_PFM

# -----------------------------------------------------------------
# 目标端: SQL Server (本机 127.0.0.1)
# -----------------------------------------------------------------
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=YourStrongPassword123
MSSQL_DATABASE=hospital_performance_dalian_derma
MSSQL_SCHEMA=dbo
# ODBC 驱动名称 (本机已安装: ODBC Driver 17 for SQL Server)
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# -----------------------------------------------------------------
# 同步行为参数
# -----------------------------------------------------------------
# 批量提交行数 (fetchmany / executemany 双向批尺寸)
SYNC_BATCH_SIZE=10000
# 是否同步前 TRUNCATE 目标表 (1=幂等清空写入, 0=仅追加)
SYNC_TRUNCATE_FIRST=1
# pyodbc fast_executemany 加速开关 (1=启用)
SYNC_FAST_EXECUTEMANY=1
# 命令超时(秒), 大表写入需放宽
SYNC_COMMAND_TIMEOUT=0
# 仅同步指定表(逗号分隔, 留空=全部)。示例: PF临时出院数据26A
SYNC_ONLY_TABLES=
